{
  "name": "lvthn",
  "version": "2.0.1",
  "description": "Command-line file encryption with paranoid-grade ciphers. Serpent-256-CBC and XChaCha20-Poly1305, WASM-SIMD accelerated, powered by leviathan-crypto.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xero/leviathan-demos.git",
    "directory": "cli"
  },
  "homepage": "https://leviathan.3xi.club",
  "type": "module",
  "bin": {
    "lvthn": "bin/lvthn"
  },
  "files": [
    "bin/"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "vitest run --project source",
    "test:dist": "vitest run --project dist",
    "test:watch": "vitest --project source --reporter=verbose",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "_shorthand": "# bake=build  fix=lint:fix  check=test  checkfull=check+bake+test:dist",
    "bake": "bun run build",
    "check": "bun run test",
    "fix": "bun run lint:fix",
    "checkfull": "bun check && bun bake && bun test:dist"
  },
  "optionalDependencies": {
    "@xero/lvthn-darwin-arm64": "2.0.1",
    "@xero/lvthn-darwin-x64": "2.0.1",
    "@xero/lvthn-linux-arm64": "2.0.1",
    "@xero/lvthn-linux-x64": "2.0.1",
    "@xero/lvthn-win32-x64": "2.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "leviathan-crypto": "2.0.1",
    "eslint": "10.2.0",
    "bun-types": "1.3.11",
    "vitest": "4.1.4"
  },
  "keywords": [
    "cli",
    "command-line",
    "terminal",
    "binary",
    "cross-platform",
    "encryption",
    "file-encryption",
    "stream-encryption",
    "cryptography",
    "crypto",
    "security",
    "serpent",
    "serpent-256",
    "chacha20",
    "xchacha20",
    "xchacha20-poly1305",
    "aead",
    "wasm",
    "simd",
    "scrypt",
    "key-derivation",
    "keyfile",
    "keygen",
    "passphrase",
    "armor"
  ]
}
